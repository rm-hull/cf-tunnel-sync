{
  "required": [
    "server",
    "cloudflare",
    "tunnel",
    "docker",
    "labels",
    "reconcile",
    "dns"
  ],
  "properties": {
    "server": {
      "required": [
        "listen",
        "log_level",
        "log_format",
        "state_path",
        "status_refresh",
        "metrics",
        "dry_run"
      ],
      "properties": {
        "listen": {
          "type": "string",
          "description": "HTTP listen address for the status page (e.g., :5000)."
        },
        "log_level": {
          "type": "string",
          "description": "Log level: DEBUG, INFO, WARN, or ERROR."
        },
        "log_format": {
          "type": "string",
          "description": "Log output format: json or text."
        },
        "state_path": {
          "type": "string",
          "description": "File path for persistent state (JSON)."
        },
        "status_refresh": {
          "type": "string",
          "description": "Meta-refresh interval for the status page; 0 disables auto-refresh."
        },
        "metrics": {
          "type": "boolean",
          "description": "Enable the Prometheus /metrics endpoint."
        },
        "dry_run": {
          "type": "boolean",
          "description": "Log actions without making any API changes."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Server and logging settings."
    },
    "cloudflare": {
      "required": [
        "api_token",
        "account_id",
        "zone_id"
      ],
      "properties": {
        "api_token": {
          "type": "string",
          "description": "Cloudflare API token with Tunnel edit permissions (REQUIRED)."
        },
        "account_id": {
          "type": "string",
          "description": "Cloudflare account ID for tunnel creation (REQUIRED)."
        },
        "zone_id": {
          "type": "string",
          "description": "Optional fallback zone ID when zone detection fails."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Cloudflare API credentials."
    },
    "tunnel": {
      "required": [
        "name",
        "external_id",
        "cloudflared"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Tunnel name used for Cloudflare tunnel resource (REQUIRED unless external_id is set)."
        },
        "external_id": {
          "type": "string",
          "description": "UUID of an externally-managed tunnel; skips cloudflared container lifecycle."
        },
        "cloudflared": {
          "required": [
            "container_name",
            "image",
            "network",
            "metrics_port"
          ],
          "properties": {
            "container_name": {
              "type": "string",
              "description": "Docker container name for the cloudflared process."
            },
            "image": {
              "type": "string",
              "description": "Docker image for cloudflared (e.g., cloudflare/cloudflared:latest)."
            },
            "network": {
              "type": "string",
              "description": "Docker network the cloudflared container joins."
            },
            "metrics_port": {
              "type": "integer",
              "description": "TCP port exposed by cloudflared for Prometheus metrics."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "description": "Cloudflared container configuration."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Tunnel and cloudflared container settings."
    },
    "docker": {
      "required": [
        "host"
      ],
      "properties": {
        "host": {
          "type": "string",
          "description": "Docker daemon socket or TCP address (defaults to DOCKER_HOST or platform default)."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Docker API connection settings."
    },
    "labels": {
      "required": [
        "prefixes",
        "allow_unprotected_access"
      ],
      "properties": {
        "prefixes": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Label key prefixes to scan for tunnel rules (e.g., cloudflare.tunnel, dockflare)."
        },
        "allow_unprotected_access": {
          "type": "boolean",
          "description": "Allow rules that reference Cloudflare Access-protected zones without credentials."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Docker label parsing settings."
    },
    "reconcile": {
      "required": [
        "grace_period",
        "resync_interval",
        "debounce"
      ],
      "properties": {
        "grace_period": {
          "pattern": "^([0-9]+(?:\\.[0-9]+)?(?:ns|us|µs|ms|s|m|h))+$",
          "type": "string",
          "description": "Time to wait before removing a rule after its container disappears (e.g., 8h).",
          "format": "duration"
        },
        "resync_interval": {
          "pattern": "^([0-9]+(?:\\.[0-9]+)?(?:ns|us|µs|ms|s|m|h))+$",
          "type": "string",
          "description": "Interval between full reconciliation passes (e.g., 5m).",
          "format": "duration"
        },
        "debounce": {
          "pattern": "^([0-9]+(?:\\.[0-9]+)?(?:ns|us|µs|ms|s|m|h))+$",
          "type": "string",
          "description": "Debounce window for Docker events; burst events produce one pass (e.g., 2s).",
          "format": "duration"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Reconciliation loop timing settings."
    },
    "dns": {
      "required": [
        "overwrite_conflicts"
      ],
      "properties": {
        "overwrite_conflicts": {
          "type": "boolean",
          "description": "Automatically overwrite existing DNS CNAME records that conflict with tunnel rules."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "DNS record management settings."
    }
  },
  "additionalProperties": false,
  "type": "object",
  "description": "cf-tunnel-sync configuration schema",
